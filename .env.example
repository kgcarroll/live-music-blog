# Sanity (public reads + Studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token - required for draft mode + live preview (sanity.io/manage, API, Tokens)
SANITY_API_READ_TOKEN=

# Site URL for Presentation tool iframe + stega (production: https://your-domain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: full Studio URL if Studio is hosted elsewhere (defaults to NEXT_PUBLIC_SITE_URL + /studio)
# NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3000/studio

# Contact (Resend - https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional verified sender, e.g. "Live Music <mail@yourdomain.com>"
# RESEND_FROM=

# Optional: Sanity webhook POST /api/revalidate (instant ISR)
SANITY_REVALIDATE_SECRET=

# Algolia sitewide search (/search) — use a search-only API key for the public vars
NEXT_PUBLIC_ALGOLIA_APPLICATION_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=
# Admin key: never expose to the browser. Used for `npm run algolia:index` and server reindex.
ALGOLIA_ADMIN_API_KEY=
# Secret for POST /api/algolia/reindex (Sanity webhook or manual curl). Not required for local CLI index.
ALGOLIA_REINDEX_SECRET=
